# --- Provider credentials -------------------------------------------------------------
# Only the key for the provider selected by MODEL_NAME is required.
DEEPSEEK_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here

# --- Model & context budget -------------------------------------------------------------
# Provider is inferred from the prefix: deepseek-* -> DeepSeek, claude-* -> Anthropic.
# Supported: deepseek-flash (default), claude-sonnet-5-5
MODEL_NAME=deepseek-flash

# Max output tokens per model call. 2048 leaves headroom for Claude's always-on thinking.
MAX_TOKENS=2048

# Sampling temperature. Sent to DeepSeek (thinking disabled so it takes effect).
# Logged but NOT sent to Claude: the current Claude API rejects `temperature`.
TEMPERATURE=0.0

# Claude only: reasoning effort (low | medium | high | xhigh | max). Ignored for DeepSeek.
EFFORT=low

# DeepSeek only: OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Per-request timeout in seconds for both providers (SDK default would be 10 minutes).
# A timeout ends that email with stop_reason=provider_error; it is not retried.
REQUEST_TIMEOUT_S=60
